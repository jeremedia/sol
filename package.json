{
  "name": "@jeremedia/sol-workspace",
  "private": true,
  "version": "0.0.0-modernization",
  "description": "Modern Sol workspace",
  "repository": "git://github.com/MuseumofModernArt/sol.git",
  "author": "MoMA Digital Media",
  "license": "SEE LICENSE IN README.MD",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:tokens": "npm run build:tokens --workspace @jeremedia/sol-core",
    "check:tokens": "npm run check:tokens --workspace @jeremedia/sol-core",
    "build:core": "npm run build --workspace @jeremedia/sol-core",
    "check:core": "npm run check:artifacts --workspace @jeremedia/sol-core",
    "build:tailwind": "npm run build --workspace @jeremedia/sol-tailwind",
    "check:tailwind": "npm run check:artifacts --workspace @jeremedia/sol-tailwind",
    "build:docs": "npm run build --workspace @jeremedia/sol-docs",
    "check:docs": "npm run check:artifacts --workspace @jeremedia/sol-docs",
    "check:packages": "npm run check:core && npm run check:tailwind",
    "check:artifacts": "npm run check:packages && npm run check:docs",
    "build": "npm run build:core && npm run build:tailwind && npm run build:docs",
    "release": "node ./bin/release.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "happy-dom": "^20.8.9",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": "24.x"
  }
}
