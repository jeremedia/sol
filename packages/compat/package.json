{
  "name": "@jeremedia/sol-compat",
  "private": true,
  "version": "0.0.0-modernization",
  "description": "Compatibility package for legacy Sol CSS and runtime entry points",
  "main": "dist/sol.js",
  "style": "dist/sol.css",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/sol.js",
    "./sol.css": "./dist/sol.css",
    "./sol.css.map": "./dist/sol.css.map",
    "./sol.min.css": "./dist/sol.min.css",
    "./sol.min.css.map": "./dist/sol.min.css.map",
    "./sol.js": "./dist/sol.js"
  },
  "scripts": {
    "build": "node ./scripts/sync-compat-artifacts.mjs",
    "check:artifacts": "node ./scripts/sync-compat-artifacts.mjs --check"
  }
}
